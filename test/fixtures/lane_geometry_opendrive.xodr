<?xml version="1.0" encoding="UTF-8"?>
<!-- One small case per road, far apart so they do not touch:
     Roads 1 and 2 (y = 0): road 1 has two lane sections, a second right lane (-2) starts at s=50; road 2 follows it.
     Road 3 (y = -100): lane -1 grows from 2 m at s=0 to 3 m at s=20 (cubic), then a second width record: 4 m.
     Road 4 (y = -200): laneOffset moves the lanes 2 m to the left over 40 m.
     Roads 5 and 6 (y = -300): road 5 ends in a 90 degree left turn only 0.08 m long; road 6 follows it.
     Road 7 (x = 3): heads exactly north, so every point has the same x.
     Road 8 (y = -500): laneOffset jumps 2 m at s=50, where lane -1 ends, so lane -2 carries straight on as lane -1.
     Road 9 (y = -600): a 1 mm first section whose width record is only valid inside it, and a 1 cm last section.
     Roads 30 to 33 (y = -700): a one-way loop. Road 30 has 2 lanes and forks to road 33: straight on road 31 (3 lane sections, 10 m),
     or a detour on road 32 (about 16 m). Road 33 comes back round to road 30 on its 2 left lanes. -->
<OpenDRIVE>
    <header revMajor="1" revMinor="4" name="lane_geometry" version="1" date="2025-01-01"
            north="10" south="-710" east="150" west="-10" vendor="avlite-test"/>
    <road name="two_section_road" length="100.0" id="1" junction="-1">
        <link><successor elementType="road" elementId="2" contactPoint="start"/></link>
        <planView>
            <geometry s="0" x="0" y="0" hdg="0" length="100.0"><line/></geometry>
        </planView>
        <lanes>
            <laneSection s="0">
                <center><lane id="0" type="none" level="false"/></center>
                <left>
                    <lane id="1" type="driving" level="false"><link><successor id="1"/></link><width sOffset="0" a="3.5" b="0" c="0" d="0"/></lane>
                </left>
                <right>
                    <lane id="-1" type="driving" level="false"><link><successor id="-1"/></link><width sOffset="0" a="3.5" b="0" c="0" d="0"/></lane>
                </right>
            </laneSection>
            <laneSection s="50">
                <center><lane id="0" type="none" level="false"/></center>
                <left>
                    <lane id="1" type="driving" level="false"><link><predecessor id="1"/><successor id="1"/></link><width sOffset="0" a="3.5" b="0" c="0" d="0"/></lane>
                </left>
                <right>
                    <lane id="-1" type="driving" level="false"><link><predecessor id="-1"/><successor id="-1"/></link><width sOffset="0" a="3.5" b="0" c="0" d="0"/></lane>
                    <lane id="-2" type="driving" level="false"><width sOffset="0" a="3.5" b="0" c="0" d="0"/></lane>
                </right>
            </laneSection>
        </lanes>
    </road>
